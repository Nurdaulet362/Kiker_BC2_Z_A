  "narrative": {
    "northStar": "The Editorial Training Workbook",
    "overview": "The Editorial Training Workbook uses a dark ink-violet navigation rail, quiet paper surfaces and compact annotations to make practical work feel legible and considered. DM Sans carries the interface; monospaced formulas and tabular money values make the underlying evidence easy to inspect.\n\nControls are restrained and familiar. Violet identifies actions, while green, amber and red communicate outcomes beside explicit text. This document records the implemented direction; descriptive names and atmosphere are implementation assumptions made under the user’s delegation, not a separately approved brand identity.",
    "keyCharacteristics": [
      "Compact editorial hierarchy with generous separation between work areas.",
      "Flat worksheet surfaces, explicit borders and a dark navigation anchor.",
      "Visible formulas, aligned figures and feedback explained in words."
    ],
    "rules": [
      {
        "name": "The Explicit Status Rule",
        "body": "Pair semantic colors with labels or explanatory text.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use the muted token for small neutral worksheet labels.",
      "Do preserve tabular money values and separate reported totals from expected totals.",
      "Do keep visible focus outlines and pair status colors with text.",
      "Do stack the worksheet and validation panel on narrow screens."
    ],
    "donts": [
      "Don’t replace the status selector with a decorative badge.",
      "Don’t remove the border separating worksheet regions.",
      "Don’t apply dialog shadows to ordinary worksheet panels."
    ]
  }
